<?xml version="1.0"?>
<ruleset name="WooCommerce Review Reminder">
	<description>Coding standards for WooCommerce Review Reminder.</description>

	<file>.</file>

	<arg name="basepath" value="." />
	<arg name="extensions" value="php" />
	<arg name="colors" />
	<arg value="sp" />
	<arg name="parallel" value="8" />

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/js/*</exclude-pattern>

	<!-- PHP 8.1 is the plugin minimum. -->
	<config name="testVersion" value="8.1-" />
	<config name="minimum_supported_wp_version" value="6.2" />

	<!-- WooCommerce provides the manage_woocommerce capability. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce" />
			</property>
		</properties>
	</rule>

	<!-- WordPress standards (WordPress-Extra includes Core + recommended). -->
	<rule ref="WordPress-Extra" />

	<!--
		The plugin uses a PSR-4 style autoloader with CamelCase class files,
		so the classic "class-foo.php" file naming rule does not apply.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
	</rule>

	<!--
		Repositories inject $wpdb as a constructor dependency and prepare all
		queries with the WP 6.2+ %i identifier placeholder. The
		WordPress.DB.PreparedSQL sniff cannot statically verify queries when
		prepare() is invoked through a property, producing false positives.
		Queries are verified by review and runtime tests.
	-->
	<rule ref="WordPress.DB.PreparedSQL">
		<severity>0</severity>
	</rule>

	<rule ref="Squiz.Commenting.FileComment.Missing">
		<severity>0</severity>
	</rule>

	<!--
		Server-rendered admin views in app/Admin/Views echo markup through
		static helpers (View::page_header(), Icons::get(), __()). Escaping is
		enforced at every point where dynamic values are interpolated (each is
		wrapped in esc_html()/esc_attr()); the OutputNotEscaped sniff flags the
		helper calls themselves, producing false positives.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>*/app/Admin/Views/*</exclude-pattern>
		<exclude-pattern>*/app/Admin/AdminMenu.php</exclude-pattern>
	</rule>
</ruleset>
